# Pin this to an exact published Aldus release. Do not use latest for real data.
ALDUS_VERSION=0.1.0-beta.15
ALDUS_BIND_HOST=127.0.0.1
ALDUS_PORT=8080

# Host folders mounted into the container. Aldus reads Sources without modifying them.
ALDUS_SOURCE_PATH=./library-media
# The same completed-download host folder mounted into qBittorrent.
ALDUS_DOWNLOAD_PATH=./downloads

# Set true when Aldus is served through HTTPS. Plain HTTP requires false.
ALDUS_SECURE_COOKIES=false
# Required acknowledgement when binding plain HTTP beyond this machine.
ALDUS_ALLOW_INSECURE_HTTP=false

# Maximum uploaded media size in bytes (2 GiB by default).
ALDUS_MAX_UPLOAD_BYTES=2147483648
