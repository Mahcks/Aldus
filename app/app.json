{
  "expo": {
    "name": "Aldus",
    "slug": "aldus",
    "scheme": "aldus",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mahcks.aldus",
      "infoPlist": {
        "DEV_CLIENT_TRY_TO_LAUNCH_LAST_BUNDLE": false,
        "NSLocalNetworkUsageDescription": "Aldus connects to your local development server and Metro on your network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.mahcks.aldus"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "./plugins/with-readium",
      [
        "expo-dev-client",
        {
          "launchMode": "launcher",
          "toolsButton": false
        }
      ],
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
