{
  "name": "aldus-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.5",
  "main": "expo-router/entry",
  "scripts": {
    "start": "EXPO_PUBLIC_WEB_API_URL=${EXPO_PUBLIC_WEB_API_URL:-${EXPO_PUBLIC_API_URL:-http://localhost:8080}} expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "ios:device": "expo run:ios --device --no-bundler",
    "start:dev-client": "expo start --dev-client --lan -c",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/source-serif-4": "^0.4.1",
    "@expo/metro-runtime": "~57.0.9",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "clsx": "^2.1.1",
    "expo": "~57.0.12",
    "expo-asset": "~57.0.10",
    "expo-audio": "~57.0.3",
    "expo-constants": "~57.0.10",
    "expo-dev-client": "~57.0.11",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "foliate-js": "1.0.1",
    "nativewind": "5.0.0-preview.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-css": "^3.0.7",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-readium": "5.0.0-rc.18",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "resolutions": {
    "lightningcss": "1.30.1"
  },
  "patchedDependencies": {
    "react-native-readium@5.0.0-rc.18": "patches/react-native-readium@5.0.0-rc.18.patch",
    "foliate-js@1.0.1": "patches/foliate-js@1.0.1.patch"
  }
}
