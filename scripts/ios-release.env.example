# Copy this file to scripts/ios-release.env on the Mac mini.
# None of these values are credentials; authenticate separately with `asc auth login` and `eas login`.
# ASC_APP_ID is normally discovered from com.mahcks.aldus. Uncomment only if discovery is unavailable.
# ASC_APP_ID=1234567890
ASC_INTERNAL_TESTFLIGHT_GROUP="Aldus Internal"
ASC_EXTERNAL_TESTFLIGHT_GROUP="Aldus External"

# Optional: used by make ios-acceptance when it cannot infer the team from a signing identity.
# IOS_DEVELOPMENT_TEAM=ABCDE12345

# Optional: run `make ios-testflight-remote` from another trusted machine.
MAC_BUILD_HOST=maxs-mac-mini.local
MAC_BUILD_PATH=/Users/max/Code/aldus
